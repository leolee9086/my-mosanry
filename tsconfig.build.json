    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": false,
        "declarationDir": "./dist/types",
        "rootDir": "./src"
    },
    "include": [
        "src/**/*.ts",
        "src/index.ts"
