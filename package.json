{
  "name": "@leolee9086/my-masonry",
  "version": "0.1.0",
  "type": "module",
  "description": "A high-performance, general-purpose virtual masonry/grid layout component for Vue 3.",
  "main": "./dist/my-masonry.umd.js",
  "module": "./dist/my-masonry.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/my-masonry.es.js",
      "require": "./dist/my-masonry.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "masonry",
    "grid",
    "virtual-scroll",
    "virtual-list",
    "component",
    "layout",
    "infinite-scroll"
  ],
  "author": "leolee9086",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/my-mosanry.git"
  },
  "bugs": {
    "url": "https://github.com/leolee9086/my-mosanry/issues"
  },
  "homepage": "https://github.com/leolee9086/my-mosanry#readme",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/rbush": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "p-queue": "^8.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.12"
  }
}